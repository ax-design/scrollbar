{
    "name": "@ax-design/scrollbar",
    "version": "0.3.1",
    "description": "Web components that replace the scrollbars of a container or of the page with ones you style with CSS, for Axiom Design System.",
    "main": "build/main.js",
    "module": "es/index.js",
    "typings": "es/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ax-design/scrollbar.git"
    },
    "license": "MIT",
    "sideEffects": false,
    "dependencies": {
        "@ax-design/elevation": "^0.2.3",
        "@ax-design/scroll": "^0.2.1",
        "@ax-design/shape": "^0.3.0",
        "@ax-design/surface": "^0.4.1",
        "@ax-design/typed-om": "^0.3.0"
    },
    "devDependencies": {
        "@ax-design/acrylic": "^0.3.2",
        "@types/bun": "latest",
        "playwright": "^1.64.0",
        "typescript": "^5.6.0"
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "check": "tsc -p tsconfig.json",
        "test": "bun test",
        "test:browser": "bun test-browser/run.ts",
        "demo": "bun demo/serve.ts",
        "prepublishOnly": "bun run build"
    },
    "homepage": "https://github.com/ax-design/scrollbar#readme",
    "bugs": {
        "url": "https://github.com/ax-design/scrollbar/issues"
    },
    "files": [
        "build",
        "es",
        "src"
    ],
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "source": "./src/index.ts",
            "import": "./es/index.js",
            "require": "./build/main.js",
            "default": "./es/index.js"
        },
        "./kits/luna": {
            "types": "./es/kits/luna/index.d.ts",
            "source": "./src/kits/luna/index.ts",
            "import": "./es/kits/luna/index.js",
            "require": "./build/kits/luna.js",
            "default": "./es/kits/luna/index.js"
        },
        "./package.json": "./package.json"
    }
}
